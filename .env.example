# Formulario de contacto: lo envía la función /api/contact con Nodemailer por SMTP.
# Imprescindible antes de lanzar anuncios. Solo en el servidor: en Vercel › Settings › Environment Variables
# (nunca con prefijo VITE_, que las expondría en el navegador). Ejemplo con Hostinger: smtp.hostinger.com, 465.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# buzón que recibe los leads y remitente de los avisos (por defecto, SMTP_USER)
MAIL_TO=info@ioscraft.app
MAIL_FROM=

# Medición de campañas (opcional). Sin ningún ID no se carga nada ni aparece el aviso de cookies.
# Google Analytics 4 → G-XXXXXXXXXX
VITE_GA_ID=
# Google Ads → AW-XXXXXXXXXX y la etiqueta de la conversión "formulario enviado"
# (Google Ads › Objetivos › Conversiones › la acción › Configuración de etiquetas: send_to "AW-XXX/<etiqueta>")
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_LEAD_LABEL=
# Opcional: conversión secundaria para clics en WhatsApp, email o teléfono
VITE_GOOGLE_ADS_CONTACT_LABEL=
# Meta (Facebook/Instagram) Pixel
VITE_META_PIXEL_ID=

# Google Search Console: código de la etiqueta HTML de verificación (opcional si verificas por DNS)
VITE_GOOGLE_SITE_VERIFICATION=
